{
 "description": "SDK naming (x-didit-sdk) for operations whose upstream OpenAPI definition does not carry it yet. Keys: \"<METHOD> <path>\" for verification.json, \"account <METHOD> <path>\" for account.json. Upstream x-didit-sdk wins; delete an entry once upstream carries the same value. See docs/DESIGN.md section 4.",
 "version": 1,
 "operations": {
  "account GET /organizations/me/": {
   "resource": "account.organizations",
   "method": "list",
   "auth": "account_token",
   "server": true
  },
  "account GET /organizations/me/{org_id}/applications/": {
   "resource": "account.applications",
   "method": "list",
   "auth": "account_token",
   "server": true
  },
  "account GET /organizations/me/{org_id}/applications/{app_id}/": {
   "resource": "account.applications",
   "method": "retrieve",
   "auth": "account_token",
   "server": true
  },
  "account PATCH /organizations/me/{org_id}/applications/{app_id}/": {
   "resource": "account.applications",
   "method": "update",
   "auth": "account_token",
   "server": true
  },
  "account POST /organizations/me/{org_id}/applications/": {
   "resource": "account.applications",
   "method": "create",
   "auth": "account_token",
   "server": true
  },
  "account POST /programmatic/login/": {
   "resource": "account",
   "method": "login",
   "auth": "none",
   "server": true
  },
  "account POST /programmatic/register/": {
   "resource": "account",
   "method": "register",
   "auth": "none",
   "server": true
  },
  "account POST /programmatic/resend-otp/": {
   "resource": "account",
   "method": "resend_otp",
   "auth": "none",
   "server": true
  },
  "account POST /programmatic/verify-email/": {
   "resource": "account",
   "method": "verify_email",
   "auth": "none",
   "server": true
  }
 }
}